# Copy this file to `.env` and adjust as needed. The .env file is gitignored.
# Streamlit auto-loads .env via python-dotenv if you have it installed; otherwise
# `set` (Windows) or `export` (bash) the variables before launching streamlit.

# Display name shown in titles and the sidebar.
HOUSEHOLD_NAME=Household

# Label used for the household's mortgage row in the domain list.
# Match this to the value that appears in your transactions_categorised.csv.
MORTGAGE_LABEL=Housing – Mortgage

# Path to the categorised transactions CSV. Defaults to the bundled sample.
# TRANSACTIONS_CSV=path/to/transactions_categorised.csv

# Optional path to a JSON file of timeline events for chart annotations.
# Format: [{"date": "2024-02-01", "label": "Property purchased"}, ...]
# TIMELINE_EVENTS_JSON=timeline_events.json

# Where to persist manual category overrides made via the Transactions page.
# OVERRIDES_PATH=manual_overrides.json
